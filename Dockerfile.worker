FROM node:22-alpine
ENV NODE_ENV=production WORKER_PORT=3001
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY tsconfig.json ./
COPY src ./src
COPY migrations ./migrations
RUN chown -R node:node /app
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD wget -qO- http://127.0.0.1:3001/healthz || exit 1
CMD ["npx", "tsx", "src/worker/index.ts"]
