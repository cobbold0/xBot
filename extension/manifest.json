{
  "manifest_version": 3,
  "name": "JustBot X Connector",
  "version": "1.0.0",
  "description": "Connect your active X (Twitter) session to your JustBot dashboard in one click without sharing your X password.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://localhost:3007/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3007/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
