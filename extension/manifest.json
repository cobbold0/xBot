{
  "manifest_version": 3,
  "name": "JustBot X Connector",
  "version": "1.0.1",
  "description": "Connect your active X (Twitter) session to JustBot in one click without sharing your X password.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://xbot.cobbold.dev/*",
    "https://justbot.cobbold.dev/*",
    "http://localhost:3007/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xbot.cobbold.dev/*",
        "https://justbot.cobbold.dev/*",
        "http://localhost:3007/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
