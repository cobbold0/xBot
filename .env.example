# --- Required ---
DATABASE_URL=postgres://xbot:change-me@localhost:5432/xbot
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# base64("auth_token=...;ct0=...;twid=...;")  see docs/SETUP.md
X_API_KEY=REPLACE_ME_BASE64_COOKIE_STRING
DASHBOARD_PASSWORD=change-me-to-a-long-passphrase
SESSION_SECRET=replace-with-64-random-hex-chars

# --- General ---
TZ=UTC
ANTHROPIC_MODEL=claude-sonnet-5-5
# USD per million tokens, used for cost estimates (verify against current pricing)
ANTHROPIC_PRICE_INPUT_PER_MTOK=3
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=15

# --- Initial safe defaults (can be changed in dashboard Settings; env only seeds first run) ---
DRY_RUN=true
AUTO_PUBLISH=false
AUTO_LIKE=false
AUTO_REPOST=false
AUTO_REPLY=false
DAILY_BUDGET_USD=2
MONTHLY_BUDGET_USD=30
MAX_POSTS_PER_DAY=3
MAX_LIKES_PER_DAY=20
MAX_REPOSTS_PER_DAY=5
MAX_REPLIES_PER_DAY=5
MAX_POSTS_PROCESSED_PER_RUN=15
POSTGRES_PASSWORD=change-me
