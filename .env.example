# --- Required ---
DATABASE_URL=postgres://xbot:change-me@localhost:5432/xbot
# raw "auth_token=...;ct0=...;twid=...;" (or its base64); see docs/SETUP.md
X_API_KEY=REPLACE_ME_BASE64_COOKIE_STRING
DASHBOARD_PASSWORD=change-me-to-a-long-passphrase
SESSION_SECRET=replace-with-64-random-hex-chars
TZ=UTC

# --- AI Providers (Gemini and/or ChatGPT / OpenAI) ---
# Primary: Google Gemini (get free key at https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy-REPLACE_ME
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback or alternative: OpenAI / ChatGPT (get key at https://platform.openai.com/api-keys)
# If both keys are present, JustBot automatically switches to ChatGPT if Gemini hits quota/rate limits!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Provider priority: 'gemini' (default, with OpenAI as fallback) or 'openai' (ChatGPT first)
LLM_PROVIDER=gemini

# USD per million tokens, used for cost estimates
OPENAI_PRICE_INPUT_PER_MTOK=0.15
OPENAI_PRICE_OUTPUT_PER_MTOK=0.60
ANTHROPIC_PRICE_INPUT_PER_MTOK=0.1
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=0.4

# --- Initial safe defaults (can be changed in dashboard Settings; env only seeds first run) ---
DRY_RUN=true
AUTO_PUBLISH=false
AUTO_LIKE=false
AUTO_REPOST=false
AUTO_REPLY=false
DAILY_BUDGET_USD=2
MONTHLY_BUDGET_USD=30
MAX_POSTS_PER_DAY=3
MAX_LIKES_PER_DAY=20
MAX_REPOSTS_PER_DAY=5
MAX_REPLIES_PER_DAY=5
MAX_POSTS_PROCESSED_PER_RUN=15
POSTGRES_PASSWORD=change-me
